# Copy to .env — never commit .env
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://sih:sih_dev_password@localhost:5433/sih2?schema=public
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h

# Data providers. DEMO (default) uses the synthetic ledger and needs no keys.
# LIVE uses real explorer APIs: EVM chains (Ethereum/BNB/Polygon) need ETHEREUM_API_KEY (Etherscan v2, one key for all three);
# Bitcoin uses Esplora (key optional); Tron and Solana adapters are not implemented yet (see docs/blockchain-providers.md).
BLOCKCHAIN_PROVIDER=DEMO
ETHEREUM_API_KEY=
BITCOIN_API_KEY=
TRON_API_KEY=
SOLANA_API_KEY=
# Optional endpoint overrides
# ETHERSCAN_BASE_URL=https://api.etherscan.io/v2/api
# BITCOIN_API_URL=https://blockstream.info/api

# SAHYOG: only MOCK is available; no real API is assumed.
SAHYOG_MODE=MOCK

# Seed users (DEMO only). Password for seeded admin@demo.local / investigator@demo.local
DEMO_PASSWORD=demo-password-change-me
